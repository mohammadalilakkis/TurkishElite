# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Local: mongodb://localhost:27017/turkish-elite-tourism
# Atlas SRV: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/dbname?retryWrites=true&w=majority
# If SRV fails (ENODATA), use Atlas "standard" connection string instead
MONGODB_URI=mongodb://localhost:27017/turkish-elite-tourism

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email Configuration (Optional - for sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
