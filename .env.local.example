# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For local MongoDB: mongodb://localhost:27017/turkish-elite-tourism
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/turkish-elite-tourism
MONGODB_URI=mongodb://localhost:27017/turkish-elite-tourism

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend API URL (optional, defaults to http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api
